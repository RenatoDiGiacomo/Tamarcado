# Ambiente da API para o modo DEV híbrido (API rodando NATIVA no host).
# O `pnpm dev` copia este arquivo para `apps/api/.env` na primeira execução.
# Diferença-chave vs. o compose full: os hosts apontam para `127.0.0.1`
# (a infra está em containers com portas publicadas no host), não para os
# nomes de serviço do Docker (`mysql`, `redis`, `evolution-api`).

PORT=3000

# Ambiente. Em DEV mantenha `development` — habilita o CORS de rede local
# (testar o painel pelo celular) e o Swagger. NO VPS/PRODUÇÃO use
# `NODE_ENV=production` (obrigatório): o CORS de dev é FAIL-CLOSED — se NODE_ENV
# faltar, a API já trata como produção (CORS estrito), mas defina explicitamente.
NODE_ENV=development

# --- Banco (MySQL do docker-compose.infra, publicado em 127.0.0.1:3307) ---
# Porta 3307 (não 3306) para não colidir com outros MySQL locais na 3306.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=tamarcado_dev

# --- Redis (publicado em 127.0.0.1:6379) ---
REDIS_URL=redis://127.0.0.1:6379

# --- JWT (obrigatório — a API não sobe sem JWT_SECRET) ---
# TTLs em SEGUNDOS (access 15min=900; refresh 7 dias=604800).
JWT_SECRET=dev-secret-change-in-prod
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_REFRESH_TTL=604800

# --- Login (DL-052): o backend resolve o tenant pelo E-MAIL (URL única, sem slug).
# Não há flag de tenant único — o login por e-mail funciona igual em dev e prod.

# --- Integrações / CORS ---
# Origem do painel Vite (para o CORS liberar o browser em dev).
# PRODUÇÃO (DL-069): https://app.tamarcado.tec.br — o painel é quem chama a API.
# A landing page (tamarcado.tec.br) é estática e não fala com a API.
CORS_ORIGIN=http://localhost:5173
# Base do painel para montar o link de convite de equipe (Story 1.4) e o
# painelUrl/publicUrl do provisionamento (Story 1.9).
# PRODUÇÃO (DL-069): https://app.tamarcado.tec.br — apontar para a raiz manda a
# pessoa para o site institucional em vez do sistema.
WEB_BASE_URL=http://localhost:5173

# --- WhatsApp — Cloud API oficial da Meta (Story 6.1) -----------------------
# NÃO EXISTE CREDENCIAL GLOBAL DE WHATSAPP (DL-073). O provider, o número e o
# token são POR EMPRESA, na tabela `company_whatsapp_connections`, preenchidos
# pelo endpoint de plataforma:
#   PUT /api/platform/companies/{slug}/whatsapp   (header x-platform-key)
# As variáveis abaixo são do APLICATIVO da Meta (uma por ambiente), nunca de um
# estabelecimento. A antiga WHATSAPP_PROVIDER global foi REMOVIDA de propósito:
# ela decidiria por todos os tenants de uma vez.

# Segredo do aplicativo na Meta ("App Secret"). É com ele que a assinatura do
# webhook é conferida — e a assinatura é a ÚNICA prova de que a requisição veio
# da Meta. FAIL-CLOSED: sem esta variável, TODO webhook é rejeitado.
WHATSAPP_APP_SECRET=

# Token do handshake de verificação do webhook. Você escolhe o valor aqui E no
# painel da Meta (Webhooks > Verificar token); a Meta o devolve uma vez, no
# cadastro da URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Chave que CIFRA o token de cada estabelecimento em repouso (AES-256-GCM).
# Gere com `openssl rand -hex 32` — 64 caracteres hexadecimais.
# ⚠️ TROCAR ESTA CHAVE TORNA TODAS AS CONEXÕES ILEGÍVEIS: cada estabelecimento
# precisaria ser reconectado à mão. Guarde junto do backup, fora do banco.
# FAIL-CLOSED: sem ela não é possível gravar nem ler conexão nenhuma.
WHATSAPP_TOKEN_KEY=

# Endpoint da Graph API. Os padrões servem; ficam configuráveis para que subir
# de versão não dependa de um deploy de código.
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0
# Teto de espera por chamada à Meta, em ms (padrão 10000). Curto de propósito:
# nesta story o webhook ainda processa no ciclo da resposta, e demora faz a Meta
# desativar o webhook do aplicativo inteiro (DL-080). A fila da 6.20 resolve.
WHATSAPP_TIMEOUT_MS=10000

# ECO TEMPORÁRIO do smoke test da Story 6.1 — responde toda mensagem recebida.
# Desligado por padrão e IGNORADO fora de desenvolvimento. Sai na Story 6.2.
WHATSAPP_ECHO_ENABLED=false

# Provider alternativo, SÓ DESENVOLVIMENTO (DL-054): produção é exclusivamente a
# Cloud API oficial, e a factory RECUSA qualquer outro fora de dev. Usado com
# número descartável, para não queimar mensagem real a cada teste manual.
EVOLUTION_API_URL=http://127.0.0.1:8080

# --- Plataforma (Story 1.9): chave do endpoint de provisionamento ---
# Header `x-platform-key` do POST /api/platform/companies. Gere um valor forte
# e único por ambiente (ex.: `openssl rand -hex 32`). NUNCA comitar o valor real
# — este arquivo é só exemplo. Sem a chave, o endpoint fica inacessível.
PLATFORM_KEY=troque-por-um-segredo-forte

# --- E-mail transacional (Brevo) ---
# Chave da API do Brevo (painel: SMTP & API > API Keys). SEM ela o envio fica
# DESLIGADO: o sistema registra no log o que enviaria e segue — é o modo de
# desenvolvimento, ninguém precisa de credencial real para rodar o projeto.
# NUNCA comitar a chave: em produção ela vive só em /etc/tamarcado/api.env.
BREVO_API_KEY=
# Remetente. O domínio precisa estar verificado no Brevo (DKIM), senão o envio
# é recusado ou cai em spam.
MAIL_FROM=contato@tamarcado.tec.br
MAIL_FROM_NAME=Tamarcado
