# Ambiente da API para o modo DEV híbrido (API rodando NATIVA no host).
# O `pnpm dev` copia este arquivo para `apps/api/.env` na primeira execução.
# Diferença-chave vs. o compose full: os hosts apontam para `127.0.0.1`
# (a infra está em containers com portas publicadas no host), não para os
# nomes de serviço do Docker (`mysql`, `redis`, `evolution-api`).

PORT=3000

# --- Banco (MySQL do docker-compose.infra, publicado em 127.0.0.1:3307) ---
# Porta 3307 (não 3306) para não colidir com outros MySQL locais na 3306.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=tamarcado_dev

# --- Redis (publicado em 127.0.0.1:6379) ---
REDIS_URL=redis://127.0.0.1:6379

# --- JWT (obrigatório — a API não sobe sem JWT_SECRET) ---
# TTLs em SEGUNDOS (access 15min=900; refresh 7 dias=604800).
JWT_SECRET=dev-secret-change-in-prod
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_REFRESH_TTL=604800

# --- Login (DL-050): conveniência de tenant único ---
# Permite login SEM companySlug quando há exatamente 1 company (dev/1-deploy-por-
# salão). Em PRODUÇÃO multi-tenant deixe OFF (não defina, ou =0): o painel manda o
# slug pela rota /app/{slug}/login. OFF é o default seguro.
AUTH_ALLOW_SINGLE_TENANT=1

# --- Integrações / CORS ---
# Origem do painel Vite (para o CORS liberar o browser em dev).
CORS_ORIGIN=http://localhost:5173
# Base do painel para montar o link de convite de equipe (Story 1.4).
WEB_BASE_URL=http://localhost:5173

# --- WhatsApp (ativado a partir do Épico 2; Evolution em 127.0.0.1:8080) ---
WHATSAPP_PROVIDER=evolution_api
EVOLUTION_API_URL=http://127.0.0.1:8080

# --- Plataforma (Story 1.9): chave do endpoint de provisionamento ---
# Header `x-platform-key` do POST /api/platform/companies. Gere um valor forte
# e único por ambiente (ex.: `openssl rand -hex 32`). NUNCA comitar o valor real
# — este arquivo é só exemplo. Sem a chave, o endpoint fica inacessível.
PLATFORM_KEY=troque-por-um-segredo-forte