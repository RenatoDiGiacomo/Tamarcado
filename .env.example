# Copie para .env e ajuste conforme o ambiente.

# --- API ---
PORT=3000
JWT_SECRET=dev-secret-change-in-prod
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_REFRESH_TTL=604800
# TTLs em SEGUNDOS (access 15min=900; refresh 7 dias=604800)
# Base do painel web para montar o link de convite de equipe (Story 1.4) e os
# links de painelUrl/publicUrl do provisionamento (Story 1.9).
# PRODUÇÃO (DL-069): https://app.tamarcado.tec.br — o painel mora no subdomínio
# `app`; a raiz tamarcado.tec.br é a landing page. Apontar para a raiz manda a
# dona de salão para o site institucional em vez do sistema.
WEB_BASE_URL=http://localhost:5173

# --- Web (Vite) ---
# URL da API acessível pelo browser (dev: localhost).
VITE_API_URL=http://localhost:3000

# Origens permitidas para CORS na API (CSV). Em dev, a origem do painel Vite.
# PRODUÇÃO (DL-069): https://app.tamarcado.tec.br — quem chama a API é o painel.
# A landing page é estática e NÃO fala com a API, então a raiz não entra aqui.
CORS_ORIGIN=http://localhost:5173

# --- Banco (MySQL 8) ---
# Em docker-compose o host é o nome do serviço (mysql); local nativo use 127.0.0.1.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=tamarcado_dev
# Alternativa única (tem precedência sobre as variáveis discretas):
# DATABASE_URL=mysql://root:root@mysql:3306/tamarcado_dev

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- WhatsApp (ativado a partir do Épico 2) ---
WHATSAPP_PROVIDER=evolution_api
EVOLUTION_API_URL=http://evolution-api:8080
