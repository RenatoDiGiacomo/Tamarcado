{
  "name": "tamarcado",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:infra": "docker compose -f infra/compose/docker-compose.infra.yml up -d --wait",
    "dev:down": "docker compose -f infra/compose/docker-compose.infra.yml down",
    "dev:reset": "docker compose -f infra/compose/docker-compose.infra.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
